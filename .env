# ─────────────────────────────────────────────────────────────────────────────
# .env.example
# Copy this file to .env and fill in your real values.
# Never commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Twilio ──────────────────────────────────────────────────────────────────
# Find these at https://console.twilio.com → Account Info
TWILIO_ACCOUNT_SID=AC
TWILIO_AUTH_TOKEN=AC
# The WhatsApp-enabled Twilio number (sandbox: +1415125468)
TWILIO_WHATSAPP_FROM=whatsapp:

# ── OpenAI ───────────────────────────────────────────────────────────────────
# If not set, the chatbot uses the built-in keyword-based placeholder
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-3.5-turbo

# ── Flask ────────────────────────────────────────────────────────────────────
PORT=5000
FLASK_DEBUG=0

# ── Optional: Twilio webhook signature validation ────────────────────────────
# Set to "1" to enable request signature checks (recommended in production)
VALIDATE_TWILIO_SIGNATURE=0
