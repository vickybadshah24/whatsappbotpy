# ─────────────────────────────────────────────────────────────────────────────
# .env.example
# Copy this file to .env and fill in your real values.
# Never commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Twilio ──────────────────────────────────────────────────────────────────
# Find these at https://console.twilio.com → Account Info
TWILIO_ACCOUNT_SID=ACd725f3da78c5ef53e1ccd0c653b02a9a
TWILIO_AUTH_TOKEN=ACac6a8ec0fed20a53b36951525c0d0d6b
# The WhatsApp-enabled Twilio number (sandbox: +14155238886)
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# ── OpenAI ───────────────────────────────────────────────────────────────────
# If not set, the chatbot uses the built-in keyword-based placeholder
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-3.5-turbo

# ── Flask ────────────────────────────────────────────────────────────────────
PORT=5000
FLASK_DEBUG=0

# ── Optional: Twilio webhook signature validation ────────────────────────────
# Set to "1" to enable request signature checks (recommended in production)
VALIDATE_TWILIO_SIGNATURE=0
